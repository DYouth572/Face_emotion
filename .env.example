@'
APP_NAME=Face Emotion Monitor API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./face_emotion_monitor.db
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
'@ | Set-Content -Encoding UTF8 .\emotion\emotion\.env.example